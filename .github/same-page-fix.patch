diff --git a/src/hooks/useSubmissionSuccessAlignment.ts b/src/hooks/useSubmissionSuccessAlignment.ts
new file mode 100644
index 0000000..d5a8374
--- /dev/null
+++ b/src/hooks/useSubmissionSuccessAlignment.ts
@@ -0,0 +1,20 @@
+import { useLayoutEffect, useRef } from "react";
+import { alignElementIfOutsideSafeViewport } from "@/lib/pageScroll";
+
+/**
+ * Keeps a compact confirmation panel visible when it replaces a much taller
+ * form. It leaves the viewport untouched when the confirmation is already in
+ * the safe visible area.
+ */
+export function useSubmissionSuccessAlignment(active: boolean) {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useLayoutEffect(() => {
+    if (active && ref.current) {
+      alignElementIfOutsideSafeViewport(ref.current);
+    }
+  }, [active]);
+
+  return ref;
+}
